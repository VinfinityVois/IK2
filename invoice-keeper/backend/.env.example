# Copy to .env locally. Never commit .env with real values.
APP_NAME=Invoice Keeper
APP_VERSION=1.0.0
DEBUG=false
API_V1_PREFIX=/api/v1

# Generate a new random secret, e.g. with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Relative path is resolved from the backend working directory
DATABASE_URL=sqlite+aiosqlite:///./invoice_keeper.db

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-unique-password
TIMEZONE=Europe/Moscow

# Optional; leave empty when Telegram integration is not configured
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REMINDER_DAYS_BEFORE=3
