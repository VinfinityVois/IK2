# Application
APP_NAME="Invoice Keeper"
DEBUG=true
SECRET_KEY=change-me-to-a-very-long-random-string-at-least-32-chars

# Database (SQLite for quick start)
DATABASE_URL=sqlite+aiosqlite:///./invoice_keeper.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/invoice_keeper

# Admin credentials (created on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Timezone
TIMEZONE=Europe/Moscow

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=-1001234567890

# Reminders
REMINDER_DAYS_BEFORE=3
